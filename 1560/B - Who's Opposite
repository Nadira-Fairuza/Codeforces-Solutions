#include <bits/stdc++.h>
using namespace std;
 
int main() {
    int t;
    cin>>t;
    while(t--){
        int a,b,c,ans,half;
        cin>>a>>b>>c;
        int diff=abs(a-b);
        int n=2*diff;
        if(c<=n && a <= n && b <= n ){
            half=n/2;
            if(c+half<=n)cout<<c+half<<endl;
            else if(c-half>=1)cout<<c-half<<endl;
            else cout<<-1<<endl;
        }
        else cout<<-1<<endl;
 
 
    }
    return 0;
}