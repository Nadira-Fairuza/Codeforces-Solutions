#include <bits/stdc++.h>
using namespace std;
int main(){
    int t,b,square;
    cin>>t;
    while(t--){
        cin>>b;
        long long sum=0;
        for(int i=1;i<=b;i++){
            cin>>square;
            sum+=square;
        }
        long long root=sqrt(sum);
        if(root*root==sum){
            cout<<"YES"<<endl;
        }
        else
            cout<<"NO"<<endl;
    }
}